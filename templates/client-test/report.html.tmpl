<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; font-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="$subtitle">
<title>$title</title>
<style>
$fonts_css
$css
</style>
$paged_script
</head>
<body>
<main>
<section class="cover" data-section="cover" aria-labelledby="cover-title">
$cover
<p class="confidential">$confidential</p>
</section>
<section class="overview" data-section="overview" aria-labelledby="overview-title">
$overview
</section>
<section class="part-a" data-section="part-a" aria-labelledby="part-a-title">
$part_a
</section>
<section class="part-b" data-section="part-b" aria-labelledby="part-b-title">
$part_b
</section>
<section class="appendix-a" data-section="appendix-a" aria-labelledby="appendix-a-title">
$appendix_a
</section>
<section class="appendix-b" data-section="appendix-b" aria-labelledby="appendix-b-title">
$appendix_b
</section>
<section class="appendix-c" data-section="appendix-c" aria-labelledby="appendix-c-title">
$appendix_c
</section>
<section class="appendix-d" data-section="appendix-d" aria-labelledby="appendix-d-title">
$appendix_d
</section>
</main>
<footer class="screen-footer">$footer</footer>
</body>
</html>
